<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Studio tokens live here, shared with the Share extension. Must match KeychainTokenStore.accessGroup. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)net.jdbb.blyg.shared</string>
	</array>
</dict>
</plist>
